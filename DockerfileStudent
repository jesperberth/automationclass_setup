FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install --no-install-recommends sshpass openssh-client -y \
	&& apt-get upgrade -y \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

RUN pip install --no-cache-dir -r /usr/local/lib/python3.12/site-packages/ansible_collections/azure/azcollection/requirements.txt

COPY /azure/student_setup.yml ./
COPY /azure/class.azure_rm.yml ./
COPY /azure/wsl_create_user.sh ./
COPY /azure/wsl_install_docker.sh ./

ENV AZURE_PROFILE=redhat

CMD ["sh", "-c", "ansible-playbook student_setup.yml -i class.azure_rm.yml -k -e ansible_user=$username -e ansible_password=$password -e student=tag_type_student_$username"]