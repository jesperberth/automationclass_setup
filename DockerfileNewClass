FROM python:3.12-slim

WORKDIR /app

# Update system packages to reduce vulnerabilities
RUN apt-get update && apt-get upgrade -y && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

RUN pip install --no-cache-dir -r /usr/local/lib/python3.12/site-packages/ansible_collections/azure/azcollection/requirements.txt

COPY /azure/00_azure_class_setup_new.yml ./

ENV AZURE_PROFILE=redhat

CMD ["sh", "-c", "ansible-playbook -e adminUser=$username -e adminPassword=$password 00_azure_class_setup_new.yml"]