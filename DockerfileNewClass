FROM python:3.12.3-slim-bullseye

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

RUN pip install --no-cache-dir -r /usr/local/lib/python3.12/site-packages/ansible_collections/azure/azcollection/requirements.txt

COPY /azure/00_azure_class_setup_new.yml ./

ENV AZURE_PROFILE=redhat

CMD ansible-playbook -e "adminUser=$username adminPassword=$password" 00_azure_class_setup_new.yml
